# This system is read-only (never places orders), so API keys are OPTIONAL.
# Leave blank to use public market data only. Fill in only if your exchange
# requires authentication even for public order-book/OHLCV endpoints.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Secret used to protect the dashboard's (harmless) config-reload endpoint.
DASHBOARD_ADMIN_TOKEN=change-me-to-a-long-random-string
